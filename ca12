Program 11: Implementing a Simple RNN
--------------------------------------------
Build a SimpleRNN to predict a synthetic time series (a noisy sine wave), a standard
stand-in for real-world time series data such as sensor readings or stock prices.
import numpy as np
import tensorflow as tf
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt
# 1. Generate a synthetic time series
np.random.seed(42)
t = np.arange(0, 200, 0.1)
series = np.sin(t) + 0.1 * np.random.randn(len(t))
# 2. Create supervised sequences (windowing)
WINDOW = 20
def create_sequences(data, window):
 X, y = [], []
 for i in range(len(data) - window):
 X.append(data[i:i + window])
 y.append(data[i + window])
 return np.array(X), np.array(y)
X, y = create_sequences(series, WINDOW)
X = X.reshape(-1, WINDOW, 1)
split = int(0.8 * len(X))
X_train, X_test = X[:split], X[split:]
y_train, y_test = y[:split], y[split:]
# 3. Build the SimpleRNN model
model = models.Sequential([
 layers.Input(shape=(WINDOW, 1)),
 layers.SimpleRNN(32, activation="tanh", return_sequences=True),
 layers.SimpleRNN(16, activation="tanh"),
 layers.Dense(1)
])
model.compile(optimizer="adam", loss="mse")
model.summary()
# 4. Train
history = model.fit(X_train, y_train, epochs=30, batch_size=32,
 validation_split=0.1, verbose=0)
# 5. Evaluate and predict
test_loss = model.evaluate(X_test, y_test, verbose=0)
print(f"\nTest MSE: {test_loss:.4f}")
predictions = model.predict(X_test)
# 6. Plot predictions vs actual
plt.figure(figsize=(12, 5))
plt.plot(y_test, label="Actual")
plt.plot(predictions, label="Predicted")
plt.title("SimpleRNN: Time Series Prediction")
plt.xlabel("Time Step"); plt.ylabel("Value"); plt.legend(); plt.grid(True)
plt.savefig("simple_rnn_predictions.png")
plt.show()
# 7. Plot training loss
plt.figure(figsize=(8, 4))
plt.plot(history.history["loss"], label="Train Loss")
plt.plot(history.history["val_loss"], label="Val Loss")
plt.title("SimpleRNN Training Loss")
plt.legend(); plt.grid(True)
plt.savefig("simple_rnn_loss.png")
plt.show()
Program 12: Sentiment Analysis using LSTM
------------------------------------------------
Train an LSTM network to classify IMDB movie reviews as positive or negative. Dataset:
IMDB reviews (built into Keras).
import tensorflow as tf
from tensorflow.keras import layers, models
from tensorflow.keras.preprocessing.sequence import pad_sequences
import matplotlib.pyplot as plt
VOCAB_SIZE = 10000
MAX_LEN = 200
# 1. Load and preprocess data
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.imdb.load_data(
 num_words=VOCAB_SIZE)
x_train = pad_sequences(x_train, maxlen=MAX_LEN, padding="post", truncating="post")
x_test = pad_sequences(x_test, maxlen=MAX_LEN, padding="post", truncating="post")
# 2. Build the LSTM model
model = models.Sequential([
 layers.Input(shape=(MAX_LEN,)),
 layers.Embedding(VOCAB_SIZE, 128),
 layers.LSTM(64, dropout=0.2, recurrent_dropout=0.2),
 layers.Dense(32, activation="relu"),
 layers.Dropout(0.3),
 layers.Dense(1, activation="sigmoid")
])
model.compile(optimizer="adam", loss="binary_crossentropy",
 metrics=["accuracy"])
model.summary()
# 3. Train
history = model.fit(x_train, y_train, epochs=5, batch_size=128,
 validation_split=0.2)
# 4. Evaluate
test_loss, test_acc = model.evaluate(x_test, y_test, verbose=0)
print(f"\nTest Accuracy: {test_acc:.4f} | Test Loss: {test_loss:.4f}")
# 5. Inference example on a few test reviews
word_index = tf.keras.datasets.imdb.get_word_index()
reverse_word_index = {v + 3: k for k, v in word_index.items()}
reverse_word_index[0], reverse_word_index[1], reverse_word_index[2] = (
 "<pad>", "<start>", "<unk>")
def decode_review(encoded):
 return " ".join(reverse_word_index.get(i, "?") for i in encoded if i != 0)
preds = model.predict(x_test[:3])
for i in range(3):
 sentiment = "Positive" if preds[i][0] > 0.5 else "Negative"
 print(f"\nReview snippet: {decode_review(x_test[i][:40])}...")
 print(f"Predicted: {sentiment} ({preds[i][0]:.2f}) | Actual: "
 f"{'Positive' if y_test[i] == 1 else 'Negative'}")
# 6. Plot training curves
plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
plt.plot(history.history["accuracy"], label="Train")
plt.plot(history.history["val_accuracy"], label="Val")
plt.title("LSTM Sentiment Accuracy"); plt.legend(); plt.grid(True)
plt.subplot(1, 2, 2)
plt.plot(history.history["loss"], label="Train")
plt.plot(history.history["val_loss"], label="Val")
plt.title("LSTM Sentiment Loss"); plt.legend(); plt.grid(True)
plt.tight_layout()
plt.savefig("lstm_sentiment_training_curves.png")
