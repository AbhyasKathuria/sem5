Program 9: Image Segmentation using U-Net
-----------------------------------------------
Implement semantic segmentation using a U-Net architecture.
Dataset: Oxford-IIIT Pet Dataset (via tensorflow_datasets), which provides pixel-level
segmentation masks and is commonly used as a stand-in for medical-image-style
segmentation tasks in coursework.
Setup (run once):
 pip install tensorflow-datasets
import tensorflow as tf
import tensorflow_datasets as tfds
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt
IMG_SIZE = 128
# 1. Load the dataset
dataset, info = tfds.load("oxford_iiit_pet:3.*.*", with_info=True)
def load_image(datapoint):
 input_image = tf.image.resize(datapoint["image"], (IMG_SIZE, IMG_SIZE))
 input_mask = tf.image.resize(datapoint["segmentation_mask"],
 (IMG_SIZE, IMG_SIZE),
 method="nearest")
 input_image = tf.cast(input_image, tf.float32) / 255.0
 input_mask -= 1 # masks are labeled {1,2,3} -> shift to {0,1,2}
 return input_image, input_mask
train_ds = dataset["train"].map(load_image).batch(32).prefetch(tf.data.AUTOTUNE)
test_ds = dataset["test"].map(load_image).batch(32).prefetch(tf.data.AUTOTUNE)
# 2. Build the U-Net architecture
def conv_block(x, filters):
 x = layers.Conv2D(filters, 3, activation="relu", padding="same")(x)
 x = layers.Conv2D(filters, 3, activation="relu", padding="same")(x)
 return x
def build_unet(input_shape=(IMG_SIZE, IMG_SIZE, 3), num_classes=3):
 inputs = layers.Input(shape=input_shape)
 # Encoder
 c1 = conv_block(inputs, 32); p1 = layers.MaxPooling2D()(c1)
 c2 = conv_block(p1, 64); p2 = layers.MaxPooling2D()(c2)
 c3 = conv_block(p2, 128); p3 = layers.MaxPooling2D()(c3)
 # Bottleneck
 bn = conv_block(p3, 256)
 # Decoder
 u3 = layers.Conv2DTranspose(128, 2, strides=2, padding="same")(bn)
 u3 = layers.concatenate([u3, c3]); c4 = conv_block(u3, 128)
 u2 = layers.Conv2DTranspose(64, 2, strides=2, padding="same")(c4)
 u2 = layers.concatenate([u2, c2]); c5 = conv_block(u2, 64)
 u1 = layers.Conv2DTranspose(32, 2, strides=2, padding="same")(c5)
 u1 = layers.concatenate([u1, c1]); c6 = conv_block(u1, 32)
 outputs = layers.Conv2D(num_classes, 1, activation="softmax")(c6)
 return models.Model(inputs, outputs)
model = build_unet()
model.compile(optimizer="adam",
 loss="sparse_categorical_crossentropy",
 metrics=["accuracy"])
model.summary()
# 3. Train
history = model.fit(train_ds, validation_data=test_ds, epochs=15)
# 4. Visualize predictions
def display_sample(display_list, titles):
 plt.figure(figsize=(12, 4))
 for i, img in enumerate(display_list):
 plt.subplot(1, len(display_list), i + 1)
 plt.title(titles[i])
 plt.imshow(tf.keras.utils.array_to_img(img))
 plt.axis("off")
 plt.tight_layout()
for images, masks in test_ds.take(1):
 pred_masks = model.predict(images)
 pred_mask = tf.argmax(pred_masks[0], axis=-1)[..., tf.newaxis]
 display_sample(
 [images[0], masks[0], pred_mask],
 ["Input Image", "True Mask", "Predicted Mask"]
 )
 plt.savefig("unet_segmentation_output.png")
 plt.show()
Program 10: Data Augmentation for CNNs
--------------------------------------------
Apply rotation, flipping, and zooming to CIFAR-10 images to improve dataset variability,
and demonstrate the effect on CNN training.
import tensorflow as tf
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt
class_names = ["airplane", "automobile", "bird", "cat", "deer",
 "dog", "frog", "horse", "ship", "truck"]
# 1. Load data
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.cifar10.load_data()
x_train = x_train.astype("float32") / 255.0
x_test = x_test.astype("float32") / 255.0
y_train, y_test = y_train.flatten(), y_test.flatten()
# 2. Define an augmentation pipeline
data_augmentation = models.Sequential([
 layers.RandomRotation(0.1),
 layers.RandomFlip("horizontal"),
 layers.RandomZoom(0.1),
 layers.RandomTranslation(0.1, 0.1),
])
# 3. Visualize augmentation on a sample image
sample_image = x_train[0:1]
plt.figure(figsize=(10, 4))
for i in range(8):
 augmented = data_augmentation(sample_image, training=True)
 plt.subplot(2, 4, i + 1)
 plt.imshow(augmented[0])
 plt.axis("off")
plt.suptitle(f"Augmented versions of a '{class_names[y_train[0]]}' image")
plt.tight_layout()
plt.savefig("data_augmentation_samples.png")
plt.show()
# 4. Build a CNN that includes the augmentation layer
def build_model():
 inputs = layers.Input(shape=(32, 32, 3))
 x = data_augmentation(inputs)
 x = layers.Conv2D(32, 3, activation="relu", padding="same")(x)
 x = layers.MaxPooling2D()(x)
 x = layers.Conv2D(64, 3, activation="relu", padding="same")(x)
 x = layers.MaxPooling2D()(x)
 x = layers.Flatten()(x)
 x = layers.Dense(128, activation="relu")(x)
 x = layers.Dropout(0.5)(x)
 outputs = layers.Dense(10, activation="softmax")(x)
 return models.Model(inputs, outputs)
# 5. Train with augmentation and compare against no augmentation
model_aug = build_model()
model_aug.compile(optimizer="adam",
 loss="sparse_categorical_crossentropy",
 metrics=["accuracy"])
hist_aug = model_aug.fit(x_train, y_train, epochs=10, batch_size=64,
 validation_split=0.1, verbose=0)
model_plain = models.Sequential([
 layers.Input(shape=(32, 32, 3)),
 layers.Conv2D(32, 3, activation="relu", padding="same"),
 layers.MaxPooling2D(),
 layers.Conv2D(64, 3, activation="relu", padding="same"),
 layers.MaxPooling2D(),
 layers.Flatten(),
 layers.Dense(128, activation="relu"),
 layers.Dropout(0.5),
 layers.Dense(10, activation="softmax")
])
model_plain.compile(optimizer="adam",
 loss="sparse_categorical_crossentropy",
 metrics=["accuracy"])
hist_plain = model_plain.fit(x_train, y_train, epochs=10, batch_size=64,
 validation_split=0.1, verbose=0)
# 6. Compare validation accuracy
plt.figure(figsize=(8, 5))
