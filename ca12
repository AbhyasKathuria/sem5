Program 1: Basic Neural Network Implementation
------------------------------------------------
Implement a simple feedforward neural network using TensorFlow/Keras.
Dataset: MNIST (handwritten digits, built into Keras).
import tensorflow as tf
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt
# 1. Load and preprocess the dataset
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()
x_train = x_train.astype("float32") / 255.0
x_test = x_test.astype("float32") / 255.0
# 2. Build a simple feedforward (fully connected) neural network
model = models.Sequential([
 layers.Flatten(input_shape=(28, 28)),
 layers.Dense(128, activation="relu"),
 layers.Dense(64, activation="relu"),
 layers.Dense(10, activation="softmax")
])
model.compile(
 optimizer="adam",
 loss="sparse_categorical_crossentropy",
 metrics=["accuracy"]
)
model.summary()
# 3. Train the network
history = model.fit(
 x_train, y_train,
 epochs=5,
 batch_size=128,
 validation_split=0.1
)
# 4. Evaluate on test data
test_loss, test_acc = model.evaluate(x_test, y_test, verbose=0)
print(f"\nTest Accuracy: {test_acc:.4f}")
print(f"Test Loss: {test_loss:.4f}")
# 5. Plot training curves
plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
Program 2: Activation Function Comparison
-------------------------------------------
Visualize and compare ReLU, Sigmoid, and Tanh activation functions. along with their
derivatives, to understand their behavior.
import numpy as np
import matplotlib.pyplot as plt
# 1. Define the activation functions
def relu(x):
 return np.maximum(0, x)
def relu_derivative(x):
 return np.where(x > 0, 1, 0)
def sigmoid(x):
 return 1 / (1 + np.exp(-x))
def sigmoid_derivative(x):
 s = sigmoid(x)
 return s * (1 - s)
def tanh(x):
 return np.tanh(x)
def tanh_derivative(x):
 return 1 - np.tanh(x) ** 2
# 2. Generate input range
x = np.linspace(-10, 10, 400)
# 3. Plot the activation functions
plt.figure(figsize=(14, 6))
plt.subplot(2, 3, 1)
plt.plot(x, relu(x), color="tab:blue")
plt.title("ReLU"); plt.grid(True)
plt.subplot(2, 3, 2)
plt.plot(x, sigmoid(x), color="tab:orange")
plt.title("Sigmoid"); plt.grid(True)
plt.subplot(2, 3, 3)
plt.plot(x, tanh(x), color="tab:green")
plt.title("Tanh"); plt.grid(True)
# 4. Plot the derivatives
plt.subplot(2, 3, 4)
plt.plot(x, relu_derivative(x), color="tab:blue")
plt.title("ReLU Derivative"); plt.grid(True)
plt.subplot(2, 3, 5)
plt.plot(x, sigmoid_derivative(x), color="tab:orange")
plt.title("Sigmoid Derivative"); plt.grid(True)
plt.subplot(2, 3, 6)
plt.plot(x, tanh_derivative(x), color="tab:green")
plt.title("Tanh Derivative"); plt.grid(True)
plt.tight_layout()
plt.savefig("activation_function_comparison.png")
plt.show()
# 5. Discussion (printed summary)
print("""
Comparison Summary
-------------------
ReLU: Range [0, inf). Fast to compute, avoids vanishing gradients for
 positive inputs, but can suffer from the 'dying ReLU' problem
 (gradient is 0 for negative inputs).
Sigmoid: Range (0, 1). Smooth, but gradients vanish for large |x|, and
 output is not zero-centered.
Tanh: Range (-1, 1). Zero-centered (better than sigmoid for hidden
 layers), but still suffers from vanishing gradients at extremes.
""")
Program 3: Training a Multi-Layer Perceptron (MLP)
------------------------------------------------------
Train an MLP on the MNIST dataset for handwritten digit classification.
import tensorflow as tf
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt
import numpy as np
# 1. Load and preprocess data
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()
x_train = x_train.reshape(-1, 784).astype("float32") / 255.0
x_test = x_test.reshape(-1, 784).astype("float32") / 255.0
# 2. Build the MLP
model = models.Sequential([
 layers.Input(shape=(784,)),
 layers.Dense(256, activation="relu"),
 layers.Dropout(0.2),
 layers.Dense(128, activation="relu"),
 layers.Dropout(0.2),
 layers.Dense(10, activation="softmax")
])
model.compile(optimizer="adam",
 loss="sparse_categorical_crossentropy",
 metrics=["accuracy"])
model.summary()
# 3. Train
history = model.fit(x_train, y_train, epochs=10, batch_size=128,
 validation_split=0.1)
# 4. Evaluate
test_loss, test_acc = model.evaluate(x_test, y_test, verbose=0)
print(f"\nTest Accuracy: {test_acc:.4f} | Test Loss: {test_loss:.4f}")
# 5. Confusion-style qualitative check: show a few predictions
preds = np.argmax(model.predict(x_test[:10]), axis=1)
fig, axes = plt.subplots(2, 5, figsize=(12, 5))
for i, ax in enumerate(axes.flat):
 ax.imshow(x_test[i].reshape(28, 28), cmap="gray")
 ax.set_title(f"Pred: {preds[i]} | True: {y_test[i]}")
 ax.axis("off")
plt.tight_layout()
plt.savefig("mlp_mnist_predictions.png")
plt.show()
Program 4: Loss Function Exploration
----------------------------------------
Implement and compare Mean Squared Error (MSE) and Cross-Entropy loss by training
the same MLP architecture on MNIST with each loss in turn.
import tensorflow as tf
from tensorflow.keras import layers, models, utils
import matplotlib.pyplot as plt
# 1. Load and preprocess data
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()
x_train = x_train.reshape(-1, 784).astype("float32") / 255.0
x_test = x_test.reshape(-1, 784).astype("float32") / 255.0
y_train_oh = utils.to_categorical(y_train, 10)
y_test_oh = utils.to_categorical(y_test, 10)
def build_model():
 return models.Sequential([
 layers.Input(shape=(784,)),
 layers.Dense(128, activation="relu"),
 layers.Dense(10, activation="softmax")
 ])
# 2. Train with Cross-Entropy loss
model_ce = build_model()
model_ce.compile(optimizer="adam", loss="categorical_crossentropy",
 metrics=["accuracy"])
hist_ce = model_ce.fit(x_train, y_train_oh, epochs=8, batch_size=128,
 validation_split=0.1, verbose=0)
# 3. Train with Mean Squared Error loss
model_mse = build_model()
model_mse.compile(optimizer="adam", loss="mean_squared_error",
 metrics=["accuracy"])
hist_mse = model_mse.fit(x_train, y_train_oh, epochs=8, batch_size=128,
 validation_split=0.1, verbose=0)
# 4. Evaluate both
ce_loss, ce_acc = model_ce.evaluate(x_test, y_test_oh, verbose=0)
mse_loss, mse_acc = model_mse.evaluate(x_test, y_test_oh, verbose=0)
print(f"Cross-Entropy Model -> Test Accuracy: {ce_acc:.4f}, Test Loss: {ce_loss:.4f}")
print(f"MSE Model -> Test Accuracy: {mse_acc:.4f}, Test Loss: {mse_loss:.4f}")
# 5. Plot comparison of validation accuracy
plt.figure(figsize=(8, 5))
plt.plot(hist_ce.history["val_accuracy"], label="Cross-Entropy")
plt.plot(hist_mse.history["val_accuracy"], label="MSE")
plt.title("Validation Accuracy: Cross-Entropy vs MSE")
plt.xlabel("Epoch"); plt.ylabel("Validation Accuracy"); plt.legend()
plt.grid(True)
plt.savefig("loss_function_comparison.png")
plt.show()
print("""
Discussion
-----------
Cross-Entropy loss is generally preferred for classification tasks because
it directly penalizes confident wrong predictions and produces steeper,
more informative gradients when paired with a softmax output layer.
MSE, designed for regression, tends to converge more slowly and can give
weaker gradients for classification, often resulting in lower accuracy for
the same number of epochs.
""")
Program 5: Gradient Descent Optimization
--------------------------------------------
Implement and compare SGD, Adam, and RMSprop optimizers on the MNIST dataset
using an identical MLP architecture, and analyze convergence.
import tensorflow as tf
from tensorflow.keras import layers, models
import matplotlib.pyplot as plt
# 1. Load and preprocess data
(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()
x_train = x_train.reshape(-1, 784).astype("float32") / 255.0
x_test = x_test.reshape(-1, 784).astype("float32") / 255.0
def build_model():
 return models.Sequential([
 layers.Input(shape=(784,)),
 layers.Dense(128, activation="relu"),
 layers.Dense(10, activation="softmax")
 ])
optimizers = {
 "SGD": tf.keras.optimizers.SGD(learning_rate=0.01, momentum=0.9),
 "Adam": tf.keras.optimizers.Adam(learning_rate=0.001),
 "RMSprop": tf.keras.optimizers.RMSprop(learning_rate=0.001),
}
histories = {}
# 2. Train the same architecture with each optimizer
for name, opt in optimizers.items():
 print(f"\nTraining with optimizer: {name}")
 model = build_model()
 model.compile(optimizer=opt,
 loss="sparse_categorical_crossentropy",
 metrics=["accuracy"])
 hist = model.fit(x_train, y_train, epochs=8, batch_size=128,
 validation_split=0.1, verbose=0)
 histories[name] = hist
 test_loss, test_acc = model.evaluate(x_test, y_test, verbose=0)
 print(f"{name} -> Test Accuracy: {test_acc:.4f}, Test Loss: {test_loss:.4f}")
# 3. Plot convergence comparison
plt.figure(figsize=(12, 5))
plt.subplot(1, 2, 1)
for name, hist in histories.items():
 plt.plot(hist.history["val_accuracy"], label=name)
plt.title("Validation Accuracy by Optimizer")
plt.xlabel("Epoch"); plt.ylabel("Accuracy"); plt.legend(); plt.grid(True)
plt.subplot(1, 2, 2)
for name, hist in histories.items():
 plt.plot(hist.history["val_loss"], label=name)
plt.title("Validation Loss by Optimizer")
plt.xlabel("Epoch"); plt.ylabel("Loss"); plt.legend(); plt.grid(True)
plt.tight_layout()
plt.savefig("optimizer_comparison.png")
plt.show()
print("""
Discussion
-----------
SGD (with momentum) often converges more slowly and can be sensitive to the choice of
learning rate, but it can generalize well with careful tuning. Adam adjusts the learning rate for
each parameter based on estimates of first and second moments, resulting in rapid and stable
convergence right from the start. RMSprop also adapts learning rates per parameter (using a
moving average of squared gradients) and tends to perform similarly to Adam, especially on
non-stationary objectives such as recurrent network training.
""")
